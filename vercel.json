    {
      "$schema": "https://openapi.vercel.sh/vercel.json",
      "framework": null,
      "buildCommand": "echo 'Static build ready'",
      "outputDirectory": "public",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/api/(.*)",
          "destination": "https://tripvault-backend-270p.onrender.com"
        },
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
